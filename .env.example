# TG Drive — contoh konfigurasi.
# Salin menjadi `.env` lalu isi. Hak akses 600, pemilik tgdrive.
#
#     cp .env.example .env
#     chmod 600 .env
#     nano .env
#
# Nilai SECRET_KEY, TOKEN_ENC_KEY, dan ADMIN_PASSWORD_HASH dibuat otomatis
# oleh install.sh bila dikosongkan.

# 1. Token bot dari @BotFather (/newbot)
TG_BOT_TOKEN=

# 2. ID channel privat (format -100xxxxxxxxxx).
#    Bot harus jadi admin channel, lalu kirim 1 pesan ke channel.
TG_CHANNEL_ID=

# Kunci sesi Flask (otomatis dibuat saat install)
SECRET_KEY=

# Kunci enkripsi token bot per-user (otomatis dibuat saat install)
TOKEN_ENC_KEY=

# Hash password admin (otomatis dibuat saat install dari password awal)
ADMIN_PASSWORD_HASH=

# URL server Bot API lokal untuk file >20MB (opsional).
# Kosongkan = pakai api.telegram.org (batas ~20MB via API publik).
BOT_API_BASE=

# Batas upload per file dalam MB. Default 20 (API publik).
# Set 2048 bila BOT_API_BASE menunjuk ke server Bot API lokal.
MAX_UPLOAD_MB=20

# URL jalur langsung untuk pengguna PRO (opsional, contoh: https://direct.contoh.id:8443)
DIRECT_URL=

# Domain publik aplikasi (untuk link share & tombol kembali)
DOMAIN_URL=https://drive.contoh.id
