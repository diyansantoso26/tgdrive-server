# TG Drive — salin ke /home/tgdrive/app/.env lalu isi. Permission 600, owner tgdrive.
# 1. Buat bot baru via @BotFather -> /newbot -> tempel token di bawah
TG_BOT_TOKEN=
# 2. Buat channel privat -> tambahkan bot sebagai admin ->
#    forward satu pesan channel ke @userinfobot untuk dapat ID (format -100xxxxxxxxxx)
TG_CHANNEL_ID=
# Kunci sesi (dibuat otomatis saat deploy)
SECRET_KEY=
# Hash password admin (dibuat otomatis saat deploy)
ADMIN_PASSWORD_HASH=
